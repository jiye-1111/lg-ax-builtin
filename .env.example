# 복사해서 .env로 사용 (.env는 git에 올리지 않음)
API_HOST=127.0.0.1
API_PORT=8000
# 고객 링크에 쓰는 주소. 외부 공개(Q8) 정해지면 그 주소로
PUBLIC_BASE_URL=http://localhost:8000
STORAGE_DIR=./storage

# 판정 margin (기획 §9.1, Q7 결과로 조정)
FIT_MARGIN_SCANNED_MM=30
FIT_MARGIN_MEASURED_MM=5
# 1이면 스캔값만으로는 최고 조건부 (실측을 받는 운영 방식용). 시연은 스캔값만 쓰므로 0
FIT_SCANNED_MAX_CONDITIONAL=0
# 자유 배치에서 제품 등을 벽에 붙이는 거리 (m)
FIT_SNAP_M=0.3

# 1이면 data/catalog/demo_fixture.json(가상 데이터)도 불러옴. 거실 제품은 아직 가상 데이터뿐
CATALOG_INCLUDE_DEMO=0

# Blender (없으면 순수 Python 폴백으로 glb·미리보기 렌더)
# BLENDER_BIN=C:\Program Files\Blender Foundation\Blender 4.5\blender.exe
USE_BLENDER=1
BLENDER_TIMEOUT_S=300

# MCP Streamable HTTP (Claude 앱 커넥터 / Codex URL 연결용). 16자 이상 랜덤 문자열
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_HTTP_TOKEN=
# 외부 공개 호스트명 (쉼표 구분, 예: mcp.example.com)
MCP_ALLOWED_HOSTS=
# 채팅에서 project_id를 생략했을 때 쓸 프로젝트 (비우면 최근 프로젝트)
MCP_DEFAULT_PROJECT=
