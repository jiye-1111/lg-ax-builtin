# 복사해서 .env로 사용 (.env는 git에 올리지 않음)
API_HOST=127.0.0.1
API_PORT=8000
# 고객 링크에 쓰는 주소. 외부 공개(Q8) 정해지면 그 주소로
PUBLIC_BASE_URL=http://localhost:8000
# 웹을 다른 주소에 올렸을 때(Cloudflare Pages) API를 불러도 되는 웹 주소. 쉼표 구분. 팀 PC 실행은 비워 둠
# 예: CORS_ORIGINS=https://housetwin.pages.dev
CORS_ORIGINS=
STORAGE_DIR=./storage

# 판정 margin (기획 §9.1, Q7 결과로 조정)
FIT_MARGIN_SCANNED_MM=30
FIT_MARGIN_MEASURED_MM=5
# 1이면 스캔값만으로는 최고 조건부 (실측을 받는 운영 방식용). 시연은 스캔값만 쓰므로 0
FIT_SCANNED_MAX_CONDITIONAL=0
# 자유 배치에서 제품 등을 벽에 붙이는 거리 (m)
FIT_SNAP_M=0.3

# 와이파이 근사 모델 (참고용). 벽 감쇠는 콘크리트 기준, 석고보드면 3~5
WIFI_TX_DBM=20
WIFI_PATH_N=2.0
WIFI_WALL_DB_5G=12
WIFI_WALL_DB_24G=8
WIFI_GLASS_DB=4
WIFI_METAL_DB=10

# 동선: 사람이 지나가려면 필요한 최소 통로 폭 (m)
FLOW_MIN_WIDTH_M=0.9

# 1이면 data/catalog/demo_fixture.json(가상 데이터)도 불러옴. 거실 제품은 아직 가상 데이터뿐
CATALOG_INCLUDE_DEMO=0

# Blender (없으면 순수 Python 폴백으로 glb·미리보기 렌더)
# Blender는 "렌더 이미지"를 누를 때만 쓴다. 웹 3D 파일은 늘 glb.py가 만든다
# BLENDER_BIN=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
USE_BLENDER=1
BLENDER_TIMEOUT_S=300
# 렌더 엔진: 비우면 CYCLES (CPU 경로 추적 + 노이즈 제거, i7 기준 30초 안팎). 빠른 미리 보기는 EEVEE
# BLENDER_ENGINE=EEVEE
# BLENDER_SAMPLES=64

# MCP Streamable HTTP (Claude 앱 커넥터 / Codex URL 연결용). 16자 이상 랜덤 문자열
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_HTTP_TOKEN=
# 외부 공개 호스트명 (쉼표 구분, 예: mcp.example.com)
MCP_ALLOWED_HOSTS=
# 채팅에서 project_id를 생략했을 때 쓸 프로젝트 (비우면 최근 프로젝트)
MCP_DEFAULT_PROJECT=

# 말로 꾸미기(AI 추천). 서버에만 둔다. 둘 중 하나만 있어도 되고, 둘 다 비우면 키워드 규칙으로 해석
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 둘 다 있을 때 고르기 (claude | openai)
# STYLE_AI_PROVIDER=
# STYLE_AI_OPENAI_MODEL=gpt-5-mini
# STYLE_AI_MODEL=claude-opus-5-5
# STYLE_AI_TIMEOUT_S=40
